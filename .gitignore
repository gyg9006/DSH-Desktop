# 依赖与构建产物
node_modules/
out/
dist/
app/
_electron-cache/
_electron-builder-cache/
electron-vite-cache/
vite.config.*.timestamp-*.mjs

# 打包输出（交付目录在源码仓库之外）
../DSH-Desktop/
../DSH-Workbench/

# 日志与临时文件
*.log
.DS_Store
Thumbs.db
*.tmp
npm-debug.log*

# 工作文件夹仅保留占位文件，业务数据不纳入版本控制
workspace/*
!workspace/.gitkeep

# 截图目录（自行补充后提交）
screenshots/*
!screenshots/.gitkeep

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
