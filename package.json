{
  "name": "dsh-desktop",
  "productName": "DSH-Desktop",
  "version": "2.1.9",
  "description": "DSH Desktop v2.0 —— DeepSeek Harness 便携式 Windows 桌面客户端（React + 赛博朋克 UI）",
  "main": "./out/main/index.js",
  "author": {
    "name": "DSH 桌面"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gyg9006/DSH-Desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "gen:icon": "node scripts/gen-icon.mjs",
    "prepare:env": "node scripts/prepare-portable-env.mjs",
    "pack:dir": "npm run build && node scripts/gen-icon.mjs && electron-builder --win dir && node scripts/flatten-build.mjs && node scripts/verify-build.mjs",
    "release:zip": "node scripts/release.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.475.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
